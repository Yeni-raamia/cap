# ------------------------------------------------------------------
# Cap — variables d'environnement (copie ce fichier en .env.local)
# .env.local est git-ignoré : aucun secret n'est jamais commité.
# Sans ces variables, l'app démarre en MODE DÉMO (données en mémoire).
# ------------------------------------------------------------------

# --- Supabase (Phase 2) ---
# Depuis le dashboard Supabase : Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé de service (secrète, côté serveur uniquement — ne jamais exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=

# --- Personnalisation (optionnel) ---
# Nom de l'organisation/équipe affiché dans l'app (défaut neutre : « Équipe sécurité »)
NEXT_PUBLIC_ORG_NAME=

# --- Rappels par e-mail (Phase 3, optionnel) ---
# Sans clé Resend, les rappels restent uniquement in-app.
RESEND_API_KEY=
# Secret protégeant la route de cron des rappels
CRON_SECRET=
