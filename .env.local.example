# ------------------------------------------------------------------
# Cap — variables d'environnement (copie ce fichier en .env.local)
# .env.local est git-ignoré : aucun secret n'est jamais commité.
# ------------------------------------------------------------------

# --- Base de données locale (SQLite) ---
# Chemin du fichier de base. Par défaut : ./data/cap.sqlite
# (créé automatiquement au premier démarrage). Sur un serveur, tu peux
# pointer vers un dossier sauvegardé, ex. : D:/cap-data/cap.sqlite
# DATABASE_PATH=./data/cap.sqlite

# --- Mode démo (optionnel) ---
# Mettre à 1 pour lancer l'app SANS compte ni base : données en mémoire,
# non partagées, remises à zéro à chaque redémarrage (utile pour une démo).
# NEXT_PUBLIC_DEMO=0

# --- Personnalisation (optionnel) ---
# Nom de l'organisation/équipe affiché dans l'app (défaut : « Équipe sécurité »)
# NEXT_PUBLIC_ORG_NAME=

# --- Sécurité cookie (optionnel) ---
# Mettre à 1 UNIQUEMENT si l'app est servie en HTTPS. En HTTP sur le LAN,
# laisser vide/0 (sinon le cookie de session ne sera pas transmis).
# COOKIE_SECURE=0

# --- Moteur de relance (optionnel) ---
# Secret protégeant la route /api/cron/reminders. Si vide : route ouverte
# (pratique en local). En LAN/prod, définis un secret.
# CRON_SECRET=
# URL de base utilisée par « npm run reminders » (défaut : http://localhost:3000)
# CAP_URL=http://localhost:3000

# --- Rappels par e-mail (optionnel) ---
# Sans clé Resend, les rappels restent uniquement in-app.
# RESEND_API_KEY=
# Adresse d'expédition (domaine vérifié Resend, ou l'adresse de test par défaut)
# RESEND_FROM=Cap <onboarding@resend.dev>
